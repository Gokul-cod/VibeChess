{
  "name": "vibechess-local",
  "main": "deploy/worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibechess-local",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
